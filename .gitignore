# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# --- Never commit model weights ---
# These come back from Kaggle via the HF checkpoint hub repo, not git.
*.safetensors
*.bin
*.pt
*.pth
*.ckpt
*.gguf
*.onnx

# --- Never commit datasets or run artifacts ---
# /data/* ignores the corpus, stores and pulled artifacts while the two
# exceptions keep the pipeline's config and scripts tracked - a blanket
# /data/ would stop git descending at all and silently untrack them.
/data/*
!/data/configs/
!/data/scripts/
/checkpoints/
/outputs/
/runs/
/wandb/

# --- Secrets ---
.env
.env.*

# --- Agent scratch (worktrees, SDD ledgers) ---
.claude/
.superpowers/

# --- uv ---
uv.lock
